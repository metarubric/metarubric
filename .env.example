# Copy to .env and replace illustrative paths.
ACRE_MODEL_PATH=/path/to/Qwen3-4B-Instruct-2507
ACRE_READER_MODEL_PATH=/path/to/Qwen3-1.7B
ACRE_TRAIN_FILE=/path/to/workspace/healthbench/train.parquet
ACRE_VALIDATION_FILE=/path/to/workspace/healthbench/validation.parquet
ACRE_OUTPUT_DIR=/path/to/workspace/healthbench
METARUBRIC_WORK_DIR=/path/to/workspace
ACRE_PYTHON_BIN=python

ACRE_N_GPUS_PER_NODE=2
ACRE_TRAIN_BATCH_SIZE=18
ACRE_PPO_MINI_BATCH_SIZE=18
ACRE_ROLLOUT_N=8
ACRE_REWARD_NUM_WORKERS=8
ACRE_TOTAL_EPOCHS=3
ACRE_MAX_PROMPT_LENGTH=2048
ACRE_MAX_RESPONSE_LENGTH=1024
ACRE_PPO_MAX_TOKEN_LEN=8192
ACRE_LOGPROB_MAX_TOKEN_LEN=16384
ACRE_MAX_NUM_BATCHED_TOKENS=16384
ACRE_USE_KL_LOSS=False
ACRE_KL_LOSS_COEF=0
ACRE_SAVE_FREQ=10
ACRE_EXAM_EXTRACTOR_URL=http://127.0.0.1:19331
ACRE_EXAM_EXTRACTOR_MODEL=exam-qwen3-1.7b
METARUBRIC_OUTER_MODEL=gpt-5.4-mini
OPENAI_API_KEY=replace-with-api-key
